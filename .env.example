BOT_TOKEN=
GROQ_API_KEY=
LOG_GROUP_ID=-1001234567890
# Strongly recommended: Telegram numeric ID of @yucant.
# If omitted, @yucant must /start in PRIVATE chat once to bind the ID forever.
OWNER_ID=
OWNER_USERNAME=yucant
DATABASE_PATH=data/bot.sqlite3
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_KEY_ENV=GROQ_API_KEY
MODERATION_THRESHOLD=0.92
MUTE_MINUTES=60
LLM_CONCURRENCY=3
# JSON schema is supported by the default Groq model. Switch with /format json or /format text.
LLM_FORMAT=schema
# Optional: older history requires the owner's Telegram user session.
# Obtain these application credentials at https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
TG_USER_SESSION_PATH=data/history-owner.session
# Separate vision model for reading replied photos (GPT OSS is text-only).
VISION_MODEL=qwen/qwen3.8-27b
# Native rich messages; set html for an older self-hosted Bot API server.
RICH_MESSAGES=native
